// Reglas de seguridad de Cloud Firestore de Lutra.
// Copia de las reglas publicadas en la consola de Firebase (Firestore Database → Reglas).
// Si se cambian en la consola, actualizar este archivo (y al revés).
//
// Cada usuario solo puede leer y escribir su propio documento users/{uid} y todas sus
// subcolecciones (diary, emotions, minigameSessions, stars, notifications, scaleResponses
// y las que se añadan). {document=**} incluye también el propio documento del usuario.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
